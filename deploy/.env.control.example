# VM-1 control plane. Copy to deploy/.env.control (gitignored) and fill in.
# Never commit the filled file.

DOMAIN=beyonders.duckdns.org
PUBLIC_BASE_URL=https://app.beyonders.duckdns.org

# Vultr Serverless Inference: the ONLY LLM endpoint (CI guards this).
LLM_MODE=vultr
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Confirm these against GET /v1/models before deploying.
MODEL_CODER=glm-5.3
MODEL_PLANNER=glm-5.3-flash
MODEL_VISION=qwen3.8-flash-next
MODEL_SAFETY=nemotron-3.5-content-safety
MODEL_FALLBACK=deepseek-v4.1-flash-1017

# Managed PostgreSQL (VPC host). Fallback: a postgres container on VM-1.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Vultr Object Storage (S3 API). One private bucket is used by the API.
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=airlock

# Sandbox runner on VM-2, reached ONLY over the VPC.
RUNNER_URL=http://10.10.0.X:8700
RUNNER_TOKEN=            # 64 random hex chars, same value as .env.sandbox

# Ed25519 key for evidence receipts (base64 raw private key).
SIGNING_KEY_ED25519=

# Abuse / spend guards
DAILY_TOKEN_BUDGET=3000000
MAX_UPLOAD_MB=5
UPLOADS_PER_HOUR_PER_IP=10

# Reasoning-model controls (unbounded reasoning makes calls time out with no answer)
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=6000
# A failed/stuck call goes to MODEL_FALLBACK once; LLM_MAX_RETRIES = extra fallback attempts after that.
LLM_MAX_RETRIES=0
# Per-call timeouts: code-writing + vision calls, then safety/classifier/planner (short calls).
LLM_TIMEOUT_S=150
LLM_FAST_TIMEOUT_S=45
LLM_CODER_REASONING_EFFORT=medium
LLM_CODER_MAX_TOKENS=14000
