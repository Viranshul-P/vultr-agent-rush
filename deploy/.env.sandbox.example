# VM-2 sandbox host. Copy to deploy/.env.sandbox (gitignored) and fill in.
# The ONLY secret on this VM is RUNNER_TOKEN: no LLM, S3 or DB credentials.

RUNNER_TOKEN=            # same value as .env.control
RUNNER_BIND=10.10.0.Y:8700   # VM-2 VPC IP:port (compose publishes the runner here only)
RUNNER_PRIVATE_IP=10.10.0.Y
RUNNER_BACKEND=docker
SANDBOX_RUNTIME=runsc

# Sandbox images, pinned by digest (Vultr Container Registry or locally built).
IMAGE_PY=ewr.vultrcr.com/airlockcr/py-sandbox@sha256:...
IMAGE_BROWSER=ewr.vultrcr.com/airlockcr/browser-sandbox@sha256:...

# Host paths (mounted at the same path into the runner so sibling bind-mounts resolve).
RUNS_ROOT=/srv/airlock-runs
PROXY_LOG_DIR=/srv/airlock-proxy-logs

BROWSER_NETWORK=sbx-browser
# Must be an IP: Docker DNS does not work inside gVisor sandboxes.
PROXY_URL=http://172.30.0.10:8080
# Extra CIDRs the egress proxy must deny (private ranges + metadata are denied by default).
PROXY_DENY_CIDRS=10.10.0.0/24

MAX_CONCURRENT_EXEC=4
MAX_CONCURRENT_BROWSE=2
